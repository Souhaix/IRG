# ============================================================
# Google Ads
# ============================================================
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_client_id
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token

# Customer IDs (sans tirets) — Vosker
GOOGLE_ADS_VOSKER_1=1234567890
GOOGLE_ADS_VOSKER_2=1234567891
GOOGLE_ADS_VOSKER_3=1234567892

# Customer IDs — SpyPoint
GOOGLE_ADS_SPYPOINT_1=2234567890
GOOGLE_ADS_SPYPOINT_2=2234567891
GOOGLE_ADS_SPYPOINT_3=2234567892

# MCC (manager account) si nécessaire
GOOGLE_ADS_LOGIN_CUSTOMER_ID=9999999999

# ============================================================
# Facebook / Meta Ads
# ============================================================
FACEBOOK_ACCESS_TOKEN=your_long_lived_token

# Ad Account IDs (format act_XXXX) — Vosker
FACEBOOK_VOSKER_1=act_111111111
FACEBOOK_VOSKER_2=act_111111112

# Ad Account IDs — SpyPoint
FACEBOOK_SPYPOINT_1=act_222222221
FACEBOOK_SPYPOINT_2=act_222222222

# ============================================================
# Microsoft (Bing) Ads
# ============================================================
MICROSOFT_ADS_CLIENT_ID=your_client_id
MICROSOFT_ADS_CLIENT_SECRET=your_client_secret
MICROSOFT_ADS_REFRESH_TOKEN=your_refresh_token
MICROSOFT_ADS_DEVELOPER_TOKEN=your_developer_token

# Account IDs
MICROSOFT_ADS_ACCOUNT_1=33333333
MICROSOFT_ADS_ACCOUNT_2=33333334

# ============================================================
# TikTok Ads
# ============================================================
TIKTOK_ACCESS_TOKEN=your_access_token

# Advertiser ID — Vosker
TIKTOK_VOSKER_1=4444444444

# ============================================================
# SharePoint
# ============================================================
SHAREPOINT_TENANT_ID=your_tenant_id
SHAREPOINT_CLIENT_ID=your_client_id
SHAREPOINT_CLIENT_SECRET=your_client_secret
SHAREPOINT_SITE_NAME=your_site_name
SHAREPOINT_DRIVE_ID=your_drive_id
SHAREPOINT_FILE_PATH=/General/Ad_Spending.xlsx
