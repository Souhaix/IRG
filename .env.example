# Runtime
NODE_ENV=development
TIMEZONE=America/Toronto
RUN_MODE=dry
HEADLESS=false
BROWSER_CHANNEL=chrome
BROWSER_PROFILE_PATH=.profiles/main
LOG_LEVEL=info

# Optional: force specific target date (YYYY-MM-DD). Normally uses local yesterday.
TARGET_DATE_OVERRIDE=

# Optional auth helpers for first-time login only.
GOOGLE_EMAIL=
GOOGLE_PASSWORD=
META_EMAIL=
META_PASSWORD=
MICROSOFT_EMAIL=
MICROSOFT_PASSWORD=
TIKTOK_EMAIL=
TIKTOK_PASSWORD=

# SharePoint
SHAREPOINT_URL=https://vosker.sharepoint.com/:x:/r/sites/Marketing793/_layouts/15/doc2.aspx?sourcedoc=%7B65f2efcf-5a9c-4154-8cbc-ad3353849de6%7D&action=edit
