{
  "name": "irg-budget-pacing-playwright",
  "version": "1.0.0",
  "description": "Local Playwright automation for daily budget pacing across ad platforms and SharePoint Excel",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dry": "tsx src/index.ts --mode=dry",
    "run": "tsx src/index.ts --mode=write",
    "test:selectors": "tsx src/testSelectors.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.2",
    "playwright": "^1.54.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
